#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"

#define CHOICE_X_START			0
#define CHOICE_Y_START			150

#define CHOICE_GROUP			"prestige_pop"
#define CHOICE_SEP_1			3
#define CHOICE_SEP_2			5

#define STYLE_PC	1
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

#include "ui_mp/popupstyle.inc"
#include "ui/choices_setup_popmenu.menu"

#undef CHOICE_SIZE_X
#define CHOICE_SIZE_X	320

#undef CHOICE_HORIZONTAL_ALIGN
#define CHOICE_HORIZONTAL_ALIGN	HORIZONTAL_ALIGN_CENTER
#undef CHOICE_VERTICAL_ALIGN
#define CHOICE_VERTICAL_ALIGN	VERTICAL_ALIGN_CENTER

{
	menuDef
	{
		// Choice coords are from the popup's top-left, not the screen center.
		// Stock height only fits the button rows, so hold the frame open for the title and description.
		#undef CHOICE_POPUP_HEIGHT
		#define CHOICE_POPUP_HEIGHT( itemCount ) 224

		CENTER_POPUP_SETUP_ONOPEN( popup_prestige, 4, ;, setdvar ui_prestige_lock 0; setdvar ui_prestige_pct 0; setLocalVarInt ui_prestige_step 1; setfocus step1_button;, 1 )

		#define PRESTIGE_POP_TITLE( step, title ) \
			itemDef \
			{ \
				type			ITEM_TYPE_TEXT \
				rect			22 8 284 22 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER \
				text			title \
				textfont		UI_FONT_NORMAL \
				textscale		0.35 \
				textalign		ITEM_ALIGN_MIDDLE_CENTER \
				forecolor		1 1 1 1 \
				visible			when( localVarInt( ui_prestige_step ) == step ) \
				decoration \
			}

		#define PRESTIGE_POP_WARNING( warning, visArg ) \
			itemDef \
			{ \
				type			ITEM_TYPE_TEXT \
				rect			22 34 284 128 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER \
				text			warning \
				textfont		UI_FONT_NORMAL \
				textscale		0.28 \
				textalign		ITEM_ALIGN_TOP_LEFT \
				textaligny		14 \
				forecolor		CHOICE_TEXTCOLOR \
				autowrapped \
				visible			visArg \
				decoration \
			}

		#define PRESTIGE_STEP_CONFIRM ( localVarInt( ui_prestige_step ) == 3 || ( localVarInt( ui_prestige_step ) == 4 && dvarInt( ui_prestige_lock ) == 0 ) )
		#define PRESTIGE_STEP_ENTERING ( localVarInt( ui_prestige_step ) == 4 && dvarInt( ui_prestige_lock ) == 1 )

		#define PRESTIGE_POP_TITLE_VIS( title, visArg ) \
			itemDef \
			{ \
				type			ITEM_TYPE_TEXT \
				rect			22 8 284 22 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER \
				text			title \
				textfont		UI_FONT_NORMAL \
				textscale		0.35 \
				textalign		ITEM_ALIGN_MIDDLE_CENTER \
				forecolor		1 1 1 1 \
				visible			visArg \
				decoration \
			}

		PRESTIGE_POP_TITLE( 1, "@PRESTIGE_TITLE1" )
		PRESTIGE_POP_TITLE( 2, "@PRESTIGE_TITLE2" )
		PRESTIGE_POP_TITLE_VIS( "@PRESTIGE_TITLE3", when( PRESTIGE_STEP_CONFIRM ); )
		PRESTIGE_POP_WARNING( "@PRESTIGE_WARNING1", when( localVarInt( ui_prestige_step ) == 1 ); )
		PRESTIGE_POP_WARNING( "@PRESTIGE_WARNING2", when( localVarInt( ui_prestige_step ) == 2 ); )
		PRESTIGE_POP_WARNING( "@PRESTIGE_WARNING3", when( PRESTIGE_STEP_CONFIRM && dvarInt( ui_prestige_fast ) == 0 ); )
		PRESTIGE_POP_WARNING( "@PRESTIGE_RECONNECT", when( PRESTIGE_STEP_CONFIRM && dvarInt( ui_prestige_fast ) == 1 ); )

		#undef CHOICE_GROUP
		#define CHOICE_GROUP "prestige_pop"
		// Same insets as popup_leavegame: x = (popup - button) / 2 - 2, height 18, 6px off the bottom.
		#undef CHOICE_Y_START
		#define CHOICE_Y_START (224 - (CHOICE_POPUP_BORDER_Y + (CHOICE_Y_SPACING - CHOICE_SIZE_Y)) - CHOICE_SIZE_Y - CHOICE_Y_SPACING)
		#undef CHOICE_SEP_TOTAL_SPACING
		#define CHOICE_SEP_TOTAL_SPACING( itemIndex ) 0

		#define POP_HI( itemIndex, color, border, visArg ) \
			itemDef \
			{ \
				style			WINDOW_STYLE_SHADER \
				rect			CHOICE_ORIGIN( itemIndex ) (CHOICE_SIZE_X-(CHOICE_SIZE_Y/4)) CHOICE_SIZE_Y CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN \
				background		"gradient_fadein" \
				forecolor		color \
				visible			visArg \
				decoration \
			} \
			itemDef \
			{ \
				style			WINDOW_STYLE_SHADER \
				rect			(CHOICE_X( itemIndex )+(CHOICE_SIZE_X-(CHOICE_SIZE_Y/4))) CHOICE_Y( itemIndex ) (CHOICE_SIZE_Y/4) CHOICE_SIZE_Y CHOICE_HORIZONTAL_ALIGN CHOICE_VERTICAL_ALIGN \
				background		"button_highlight_end" \
				forecolor		color \
				visible			visArg \
				decoration \
			}

		CHOICE_BUTTON_BG( 1, when( localVarInt( ui_prestige_step ) == 1 ); )
		CHOICE_BUTTON_BG( 1, when( localVarInt( ui_prestige_step ) == 2 ); )
		CHOICE_BUTTON_BG( 1, when( PRESTIGE_STEP_CONFIRM ); )
		CHOICE_BUTTON_BG( 2, when( localVarInt( ui_prestige_step ) < 4 || PRESTIGE_STEP_CONFIRM ); )

		POP_HI( 1, 0.9 0.95 1 0.35, 0.8 0.95 1 0.4, when( localVarInt( ui_highlight ) == 1 && localVarString( ui_choicegroup ) == "prestige_pop" && localVarInt( ui_prestige_step ) > 0 && localVarInt( ui_prestige_step ) < 3 ); )
		POP_HI( 2, 0.9 0.95 1 0.35, 0.8 0.95 1 0.4, when( localVarInt( ui_highlight ) == 2 && localVarString( ui_choicegroup ) == "prestige_pop" && localVarInt( ui_prestige_step ) < 4 ); )
		POP_HI( 1, 0.85 0.15 0.12 0.95, 0.7 0.08 0.08 1, when( localVarInt( ui_highlight ) == 1 && localVarString( ui_choicegroup ) == "prestige_pop" && PRESTIGE_STEP_CONFIRM ); )

		CHOICE_BUTTON_FOCUS_VIS_NOHI_EX( 1, "@MENU_CONTINUE", play "mouse_click"; setLocalVarInt ui_prestige_step 2; setfocus step2_button;, ;, ;, when( localVarInt( ui_prestige_step ) == 1 );, name "step1_button" )
		CHOICE_BUTTON_FOCUS_VIS_NOHI_EX( 1, "@MENU_CONTINUE", play "mouse_click"; setLocalVarInt ui_prestige_step 3; setfocus enter_button;, ;, ;, when( localVarInt( ui_prestige_step ) == 2 );, name "step2_button" )
		CHOICE_BUTTON_FOCUS_VIS_NOHI_EX( 2, "@MENU_CANCEL", play "mouse_click"; close self;, ;, ;, when( localVarInt( ui_prestige_step ) < 4 || PRESTIGE_STEP_CONFIRM );, name "cancel_button" )
		CHOICE_BUTTON_FOCUS_VIS_NOHI_EX( 1, "@PRESTIGE_ENTER", play "enter_prestige"; setdvar ui_prestige_lock 1; setdvar ui_prestige_pct 0; setLocalVarInt ui_prestige_step 4; setLocalVarInt ui_highlight 0; setfocus prestige_lock; scriptMenuResponse "prestige_enter";, ;, ;, when( PRESTIGE_STEP_CONFIRM );, name "enter_button" forecolor 1 1 1 1 )

		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			22 8 284 22 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			text			"@PRESTIGE_ENTERING"
			textfont		UI_FONT_NORMAL
			textscale		0.35
			textalign		ITEM_ALIGN_MIDDLE_CENTER
			forecolor		1 1 1 1
			visible			when( PRESTIGE_STEP_ENTERING )
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			22 34 284 48 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			text			"@PRESTIGE_RESETTING"
			textfont		UI_FONT_NORMAL
			textscale		0.28
			textalign		ITEM_ALIGN_TOP_LEFT
			textaligny		14
			forecolor		CHOICE_TEXTCOLOR
			autowrapped
			visible			when( PRESTIGE_STEP_ENTERING )
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			22 148 284 12 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			backcolor		0.1 0.1 0.12 1
			visible			when( PRESTIGE_STEP_ENTERING )
			decoration
		}
		itemDef
		{
			style			WINDOW_STYLE_FILLED
			rect			22 148 0 12 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			exp				rect W( dvarInt( ui_prestige_pct ) * 2.84 )
			backcolor		0.95 0.75 0.2 1
			visible			when( PRESTIGE_STEP_ENTERING )
			decoration
		}
		itemDef
		{
			type			ITEM_TYPE_TEXT
			rect			22 164 284 20 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_CENTER
			exp				text( dvarInt( ui_prestige_pct ) + "%" )
			textfont		UI_FONT_NORMAL
			textscale		0.33
			textalign		ITEM_ALIGN_MIDDLE_CENTER
			textaligny		16
			forecolor		1 1 1 1
			visible			when( PRESTIGE_STEP_ENTERING )
			decoration
		}
		itemDef
		{
			name			"prestige_lock"
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_FILLED
			rect			0 0 640 480 HORIZONTAL_ALIGN_FULLSCREEN VERTICAL_ALIGN_FULLSCREEN
			backcolor		0 0 0 0
			visible			when( PRESTIGE_STEP_ENTERING )
			action
			{
				setfocus prestige_lock;
			}
		}
	}
}
