		PREPROC_TEXT_DRAW_EXP( ORIGIN_MAINFRAME 0 0, ORIGIN_PLAYER_SLOT2, exp text( dvarString( gs_kn ) ), TEXTSIZE_SMALL, (((WIDTH_MAINFRAME-18)/2)+5), -10, ITEM_ALIGN_LEFT, EOG_TEXT_COLOR visible when( dvarString( gs_kn ) != dvarString( ps_n ) && dvarString( gs_k ) != "0" && dvarString( gs_pg ) == "1" ) ) 
