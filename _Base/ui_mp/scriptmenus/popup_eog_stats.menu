#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

{
	#define WIDTH_TOPBAR			540
	#define HEIGHT_MAINFRAME		345
	#include "ui_mp/includes/eog_common.inc"

	#undef COLOR_INFO_YELLOW
	#define COLOR_INFO_YELLOW		0.95294 0.72156 0.21176 1
	#define COLOR_INFO_ORANGE		0.851 0.527 0.105 1

	menuDef
	{
		name			"popup_eog_stats"
		exp				rect X (-(WIDTH_TOPBAR/2))
		#ifdef PC
			exp			rect Y (EOG_SLIDE_Y(HEIGHT_TOPBAR))
		#else
			exp			rect Y (HEIGHT_TOPBAR)
		#endif
		rect			0 0 WIDTH_TOPBAR (HEIGHT_TOPBAR+HEIGHT_MAINFRAME+HEIGHT_TOPBAR) HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_TOP
		focusColor		COLOR_FOCUSED
		style			WINDOW_STYLE_FILLED
		onOpen
		{
			exec "setdvartotime ui_time_marker";
			setfocus eog_next;
		}
		onESC			{ close self; }
		execkeyint BUTTON_A { close self; }
		onClose			{ EOG_GO( ui_eog_next1 ) }

		EOG_HEADER
		EOG_TITLE( "@MPUI_GAME_SUMMARY", visible 1; )

		FRAMING( RECT_MAINFRAME )
		EOG_COLOR_STRIP( 1 1 1 0.15 )	

		// Inner Frames
		PREPROC_SHADER_DRAW( ORIGIN_MAINFRAME ((WIDTH_MAINFRAME-18)/2) (HEIGHT_MAINFRAME-12), 6 6, "white", EOG_INNER_COLOR, WINDOW_BORDER_SUNKEN, 1, EOG_BORDER_COLOR ) 
		PREPROC_SHADER_DRAW( ORIGIN_MAINFRAME ((WIDTH_MAINFRAME-18)/2) (HEIGHT_MAINFRAME-12), ((WIDTH_MAINFRAME-18)/2+12) 6, "white", EOG_INNER_COLOR, WINDOW_BORDER_SUNKEN, 1, EOG_BORDER_COLOR ) 
		
		// player content positioning
		#define ORIGIN_PLAYER_SLOT1		14 (34+10)
		#define ORIGIN_PLAYER_SLOT2		14 (48+10)
		#define ORIGIN_PLAYER_SLOT3		14 (64+10)
		#define ORIGIN_PLAYER_SLOT4		14 (80+10)
		#define ORIGIN_PLAYER_SLOT5		14 (96+10)
		#define ORIGIN_PLAYER_SLOT6		14 (112+10)
		
		#define ORIGIN_PLAYER_SLOT7		14 (130+10)
		#define ORIGIN_PLAYER_SLOT8		14 (143+10)
		
		#define ORIGIN_PLAYER_SLOT9		14 (166+10)
		
		#define ORIGIN_PLAYER_SLOT10		14 (190+10)
		#define ORIGIN_PLAYER_SLOT11		14 (203+10)
		
		#define ORIGIN_PLAYER_SLOT12		14 (220+10)
		#define ORIGIN_PLAYER_SLOT13		14 (233+10)
		
		#define ORIGIN_PLAYER_SLOT14		14 (260+10)
		#define ORIGIN_PLAYER_SLOT15		14 (274+10)
		#define ORIGIN_PLAYER_SLOT16		14 (290+10)
		#define ORIGIN_PLAYER_SLOT17		14 (306+10)
		
		#define ORIGIN_PLAYER_SLOT18		14 (337+10)
		
		#define ALIGNED_IN_X_KILLSTREAK			14
		#define ALIGNED_IN_Y_KILLSTREAK			116
		#define ALIGNED_IN_X_PLAYER_STATS		((WIDTH_MAINFRAME-18)/2-16)
		
		#define ICON_HARDPOINT1 "compass_objpoint_satallite"
		#define ICON_HARDPOINT2 "compass_objpoint_airstrike"
		#define ICON_HARDPOINT3 "compass_objpoint_helicopter"

		// Player Statistics
		PREPROC_TEXT_DRAW_EXP( ORIGIN_MAINFRAME 0 0, ORIGIN_PLAYER_SLOT1, exp text( dvarString( "ps_n" ) ), TEXTSIZE_SMALL, 0, -15, ITEM_ALIGN_LEFT, COLOR_INFO_YELLOW ) 

		PREPROC_TEXT_DRAW_EXP( ORIGIN_MAINFRAME 0 0, ORIGIN_PLAYER_SLOT2, exp text( "@OW_EOG_KILLS" ), TEXTSIZE_SMALL, 0, -10, ITEM_ALIGN_LEFT, EOG_TEXT_COLOR visible when( dvarString( gs_pg ) == "1" ) ) 
		PREPROC_TEXT_DRAW_EXP( ORIGIN_MAINFRAME 0 0, ORIGIN_PLAYER_SLOT2, exp text( dvarString( ps_k ) ), TEXTSIZE_SMALL, ALIGNED_IN_X_PLAYER_STATS, -10, ITEM_ALIGN_RIGHT, EOG_TEXT_COLOR visible when( dvarString( gs_pg ) == "1" ) ) 		

		PREPROC_TEXT_DRAW_EXP( ORIGIN_MAINFRAME 0 0, ORIGIN_PLAYER_SLOT3, exp text( "@OW_EOG_ACCURACY" ), TEXTSIZE_SMALL, 0, -10, ITEM_ALIGN_LEFT, EOG_TEXT_COLOR visible when( dvarString( gs_pg ) == "1" ) ) 
