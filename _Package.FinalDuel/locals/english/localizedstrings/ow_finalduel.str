VERSION          "1"
CONFIG           "C:\trees\cod3\cod3\bin\StringEd.cfg"
FILENOTES        ""

REFERENCE CALLVOTE
LANG_ENGLISH "Final Duel"

REFERENCE VOTE_TITLE
LANG_ENGLISH "Final Duel?"

REFERENCE VOTE_YES
LANG_ENGLISH "^31.^7 Yes (&&1)"

REFERENCE VOTE_NO
LANG_ENGLISH "^32.^7 No (&&1)"

REFERENCE YES
